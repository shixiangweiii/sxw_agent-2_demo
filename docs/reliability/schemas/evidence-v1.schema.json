{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sxw-agent.local/schemas/evidence-v1.schema.json",
  "title": "EvidenceSet v1",
  "description": "Tool Broker 规范化并作为内容寻址 Artifact 保存的完整检索事实。模型只接收有界 hits preview；citation 从本对象的稳定 provenance 生成。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "query_id",
    "run_id",
    "activity_id",
    "principal_id",
    "dataset_scope",
    "scope",
    "retrieval_status",
    "rewrites",
    "cost_ms",
    "degraded_reasons",
    "tool_execution_id",
    "evidence",
    "retrieved_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "query": { "type": "string", "maxLength": 32768 },
    "query_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "run_id": { "$ref": "#/$defs/runId" },
    "activity_id": { "$ref": "#/$defs/activityId" },
    "principal_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "dataset_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "scope": { "type": "string", "minLength": 1, "maxLength": 255 },
    "retrieval_status": {
      "type": "string",
      "enum": ["HIT", "MISS", "DEGRADED", "DENIED", "ERROR"]
    },
    "rewrites": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 32768 }
    },
    "cost_ms": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "degraded_reasons": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "tool_execution_id": { "$ref": "#/$defs/toolExecutionId" },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "retrieved_at": { "$ref": "#/$defs/utcTimestamp" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "retrieval_status": { "const": "HIT" } },
        "required": ["retrieval_status"]
      },
      "then": { "properties": { "evidence": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": {
          "retrieval_status": { "enum": ["MISS", "DENIED", "ERROR"] }
        },
        "required": ["retrieval_status"]
      },
      "then": { "properties": { "evidence": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "evidence_id",
        "chunk_id",
        "doc_id",
        "title",
        "document_id",
        "document_version_id",
        "index_version",
        "content_hash",
        "dataset_id",
        "scope",
        "query_id",
        "page",
        "span_start",
        "span_end",
        "content",
        "score",
        "source"
      ],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "chunk_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "doc_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "title": { "type": "string", "maxLength": 8192 },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "document_version_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "index_version": { "type": "string", "minLength": 1, "maxLength": 255 },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "dataset_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 255 },
        "query_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "page": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "span_start": { "type": "integer", "minimum": 0 },
        "span_end": { "type": "integer", "minimum": 0 },
        "content": { "type": "string" },
        "score": { "type": "number" },
        "source": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "activityId": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{12}5[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "toolExecutionId": {
      "type": "string",
      "pattern": "^tool_[0-9a-f]{12}5[0-9a-f]{3}[89ab][0-9a-f]{15}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "EvidenceSet Artifact 是公开可审计 JSON，时间使用 RFC3339 UTC。"
    }
  }
}
