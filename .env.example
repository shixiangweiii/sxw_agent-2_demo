# === LLM (DashScope, OpenAI-compatible) ===
DASHSCOPE_API_KEY=sk-***          # 运行时填入真实 key，切勿提交
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v3

# === Engine ===
ENGINE=agent_loop                 # plan_execute | agent_loop | native_loop
MAX_LOOP_ITERS=8                  # 软收尾轮次；硬熔断 = 该值 + 2
SUB_AGENT_ENGINE=auto             # auto（跟随主引擎）| adk | native
                                  # 影响 researcher 与 Claude SKILL 子 Runner；**不影响 A2A**

# === native_loop（自研 Tool-Use 循环，仅 ENGINE=native_loop 时生效）===
NATIVE_STREAMING_TOOL_EXEC=true   # tool_call 边到边跑；false = 流完再统一跑（排障安全阀）
NATIVE_MAX_TOOL_CONCURRENCY=10    # 只读工具并发批次上限（对齐 CC 默认）
NATIVE_TOOL_RESULT_MAX_CHARS=8000 # 单条 tool_result 进模型前的体积上限
CONTEXT_WINDOW_TOKENS=128000      # 压缩阈值 = 该值 - COMPACT_BUFFER_TOKENS
COMPACT_BUFFER_TOKENS=13000       # 对齐 CC
COMPACT_PRESERVE_UNITS=6          # 压缩后原样保留的尾部原子单元数

# === Services ===
AGENT_PORT=8000
ARAG_PORT=8100
ARAG_BASE_URL=http://127.0.0.1:8100
ARAG_TIMEOUT_MS=8000

# === skill-center ===
SKILL_CENTER_PORT=8200
SKILL_CENTER_BASE_URL=http://127.0.0.1:8200
SKILL_CENTER_TIMEOUT_MS=8000
SKILL_CENTER_STREAM_TIMEOUT_MS=60000
AGENT_UUID=demo-agent

# === claude-skill 沙箱 ===
SANDBOX_PROVIDER=local            # local | agentbay（agentbay 为桩，不可跑）
SKILL_CALL_TIMEOUT_SECONDS=120
SKILL_MAX_LLM_CALLS=16
SKILL_MAX_PARALLEL_CALLS=2
SKILL_RESULT_MAX_CHARS=8000

# === A2A 远程子代理服务 ===
A2A_SERVICE_HOST=127.0.0.1
A2A_SERVICE_PORT=8300
A2A_SERVICE_BASE_URL=http://127.0.0.1:8300

# === Storage backends (ports) ===
VECTOR_BACKEND=local
EMBEDDING_STORAGE_DIR=local_storage/embedding
FULLTEXT_BACKEND=local
GRAPH_BACKEND=local

LOG_LEVEL=INFO
