# 可复制为被 Git 忽略的 .env；也可只 export 真实环境变量，后者优先。
# scripts/run_all.sh 会在启动任何进程前拒绝空值或下方占位 Key。
# === LLM (DashScope, OpenAI-compatible) ===
DASHSCOPE_API_KEY=sk-***          # 运行时填入真实 key，切勿提交
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v3

# === Per-Run Engine Runtime ===
# engine 由 POST /api/v1/runs 每次必填，不存在启动期 ENGINE 开关。
MAX_LOOP_ITERS=8                  # 软收尾轮次；硬熔断 = 该值 + 2
SUB_AGENT_ENGINE=auto             # auto（跟随主引擎）| adk | native
                                  # 影响 researcher 与 Claude SKILL 子 Runner；**不影响 A2A**

# === native_loop（自研 Tool-Use 循环，Run.engine=native_loop 时生效）===
NATIVE_STREAMING_TOOL_EXEC=true   # tool_call 边到边跑；false = 流完再统一跑（排障安全阀）
NATIVE_MAX_TOOL_CONCURRENCY=10    # 只读工具并发批次上限（对齐 CC 默认）
NATIVE_TOOL_RESULT_MAX_CHARS=8000 # 单条 tool_result 进模型前的体积上限
CONTEXT_WINDOW_TOKENS=128000      # 压缩阈值 = 该值 - COMPACT_BUFFER_TOKENS
COMPACT_BUFFER_TOKENS=13000       # 对齐 CC
COMPACT_PRESERVE_UNITS=6          # 压缩后原样保留的尾部原子单元数

# === Services ===
AGENT_PORT=8000
ARAG_PORT=8100
ARAG_BASE_URL=http://127.0.0.1:8100
ARAG_TIMEOUT_MS=8000

# === Canonical Runtime / independent Worker ===
RUNTIME_DB_PATH=local_storage/runtime/runtime.db
ARTIFACT_ROOT=local_storage/artifacts
DEMO_EFFECTS_DB_PATH=local_storage/demo_effects/effects.db
RUNTIME_WORKER_ID=runtime-worker-local
RUNTIME_WORKER_CONCURRENCY=4
RUNTIME_WORKER_POLL_MS=250
RUNTIME_LEASE_SECONDS=30
RUNTIME_LEASE_RENEW_SECONDS=10
RUNTIME_SHUTDOWN_GRACE_SECONDS=20
RUNTIME_EVENT_FLUSH_MS=100
RUNTIME_EVENT_FLUSH_BYTES=2048
RUNTIME_SSE_POLL_MS=250
RUNTIME_SSE_HEARTBEAT_SECONDS=15
RUNTIME_BUSY_TIMEOUT_MS=5000
RUNTIME_DEFAULT_DEADLINE_SECONDS=600
RUNTIME_ARTIFACT_CLEANUP_INTERVAL_SECONDS=3600
RUNTIME_ARTIFACT_ORPHAN_AGE_HOURS=24

# === skill-center ===
SKILL_CENTER_PORT=8200
SKILL_CENTER_BASE_URL=http://127.0.0.1:8200
SKILL_CENTER_TIMEOUT_MS=8000
SKILL_CENTER_STREAM_TIMEOUT_MS=60000
AGENT_UUID=demo-agent

# === claude-skill 沙箱 ===
SANDBOX_PROVIDER=local            # local | agentbay（agentbay 为桩，不可跑）
SKILL_CALL_TIMEOUT_SECONDS=120
SKILL_MAX_LLM_CALLS=16
SKILL_MAX_PARALLEL_CALLS=2
SKILL_RESULT_MAX_CHARS=8000

# === A2A 远程子代理服务 ===
A2A_SERVICE_HOST=127.0.0.1
A2A_SERVICE_PORT=8300
A2A_SERVICE_BASE_URL=http://127.0.0.1:8300

# === ARAG document authority + rebuildable projections ===
VECTOR_BACKEND=local
FULLTEXT_BACKEND=local
GRAPH_BACKEND=local
RAG_DB_PATH=local_storage/arag/rag.db
RAG_STORAGE_DIR=local_storage/arag
INDEX_JOB_POLL_INTERVAL_SECONDS=0.25

# === trace 可观测（结构化轨迹；改动后须重启 agent）===
# 轨迹文件：local_storage/traces/<YYYYMMDD>/<日期>-<时分秒>-<当日序号>-<引擎>-<trace_id>.jsonl
# ⚠️ full 会记录用户原始提问与每轮模型完整输入，属**本机调试产物**，不得随评测报告分发。
TRACE_ENABLED=true
TRACE_PAYLOAD_LEVEL=full          # none | summary | full（full=调试取向；生产应默认 summary）
TRACE_DIR=local_storage/traces
TRACE_MAX_FIELD_CHARS=20000       # 单字段截断上限
TRACE_RETENTION_DAYS=7            # 启动时删除更早的日期目录；0 = 不清理

LOG_LEVEL=INFO
